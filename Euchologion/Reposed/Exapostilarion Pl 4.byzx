      {
        "id": 108,
        "elementType": "RichTextBox",
        "content": "<p class=\"neanes-paragraph-style-default-text\"><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">Verse:</span><span style=\"color:rgb(0,0,0);font-family:'Valkyrie OT A', Valkyrie OT,&quot;Source Serif&quot;,Neanes;font-size:15.3333px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;\"><span style=\"-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);display:inline !important;float:none;letter-spacing:normal;orphans:2;text-align:left;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:break-spaces;widows:2;word-spacing:0px;\"> As for man, his days are as the grass; as a flower of the field, so shall he blossom forth. </span></span><span style=\"color:#C80831;\">(</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">Psalm 102:15</span><span style=\"color:#C80831;\">)</span></p><p class=\"neanes-paragraph-style-default-text\">&nbsp;</p><p class=\"neanes-paragraph-style-default-text\"><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">Verse:</span><span style=\"color:rgb(0,0,0);font-family:'Valkyrie OT A', Valkyrie OT,&quot;Source Serif&quot;,Neanes;font-size:15.3333px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;\"><span style=\"-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);display:inline !important;float:none;letter-spacing:normal;orphans:2;text-align:left;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:break-spaces;widows:2;word-spacing:0px;\"> For when the wind is passed over it, then it shall be gone, and no longer will it know the place thereof. </span></span><span style=\"color:#C80831;\">(</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">Psalm 102:16</span><span style=\"color:#C80831;\">)</span><span style=\"color:rgb(0,0,0);font-family:'Valkyrie OT A', Valkyrie OT,&quot;Source Serif&quot;,Neanes;font-size:15.3333px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;\"><span style=\"-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);display:inline !important;float:none;letter-spacing:normal;orphans:2;text-align:left;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:break-spaces;widows:2;word-spacing:0px;\">\n\n</span></span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">Verse:</span><span style=\"color:rgb(0,0,0);font-family:'Valkyrie OT A', Valkyrie OT,&quot;Source Serif&quot;,Neanes;font-size:15.3333px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;\"><span style=\"-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);display:inline !important;float:none;letter-spacing:normal;orphans:2;text-align:left;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:break-spaces;widows:2;word-spacing:0px;\"> And the truth of the Lord abideth for ever. </span></span><span style=\"color:#C80831;\">(</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">Psalm 116:2b</span><span style=\"color:#C80831;\">)</span></p><p class=\"neanes-paragraph-style-default-text\">&nbsp;</p><p class=\"neanes-paragraph-style-default-text\"><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">Verse: </span><span style=\"color:rgb(0,0,0);font-family:'Valkyrie OT A', Valkyrie OT,&quot;Source Serif&quot;,Neanes;font-size:15.3333px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;\"><span style=\"-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);display:inline !important;float:none;letter-spacing:normal;orphans:2;text-align:left;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:break-spaces;widows:2;word-spacing:0px;\">Glory to the Father, and to the Son, and to the Holy Spirit; both now and ever, and unto the ages of ages. Amen.\n</span></span></p>",
