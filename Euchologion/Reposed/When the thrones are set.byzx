      {
        "id": 7,
        "elementType": "ModeKey",
        "templateId": 800,
        "alignment": "center",
        "mode": 8,
        "scale": "Diatonic",
        "scaleNote": "Ni",
        "martyria": "ModeSign.Delta",
        "note": "ModeSign.Ni",
        "color": "#C80831",
        "fontSize": 26.666666666666668,
        "strokeWidth": 0,
        "height": 49,
        "heightAdjustment": 0,
        "marginTop": 0,
        "marginBottom": 0,
        "bpm": 120,
        "useDefaultStyle": true,
        "ambitusLowNote": "Pa",
        "ambitusLowRootSign": "Alpha",
        "ambitusHighNote": "Pa",
        "ambitusHighRootSign": "Alpha"
      },
      {
        "id": 303,
        "elementType": "RichTextBox",
        "content": "<p class=\"neanes-paragraph-style-default-text\"><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">For the procession from the church to the cemetery, </span><span style=\"font-family:Valkyrie OT,Neanes;\">Holy God</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\"> may be chanted, or the following hymn. Although the classical books provide an old </span><span style=\"color:#C80831;font-family:Valkyrie OT,Neanes;\">(</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">slow</span><span style=\"color:#C80831;font-family:Valkyrie OT,Neanes;\">)</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\"> sticheraric setting, such a setting is precluded by the use of conveyances. We therefore provide a new </span><span style=\"color:#C80831;font-family:Valkyrie OT,Neanes;\">(</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\">brief</span><span style=\"color:#C80831;font-family:Valkyrie OT,Neanes;\">)</span><span style=\"color:#C80831;font-family:'Valkyrie OT A Italic', Valkyrie OT,Neanes;font-style:italic;font-weight:400;\"> sticheraric melody:</span></p>",
        "contentBottom": "",
        "contentLeft": "",
        "contentRight": "",
        "contentCenter": "",
        "modeChangePhysicalNote": "Pa",
        "modeChangeScale": "Diatonic",
        "modeChangeBpm": 120,
        "height": 74.66666666666667,
        "marginTop": 0,
        "marginBottom": 8
      },
